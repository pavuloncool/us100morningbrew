US100_STORAGE_PROVIDER=auto
US100_GENERATION_PROVIDER=fixture
US100_GENERATION_TARGET_STATUS=draft
US100_CRON_LOCALES=pl,en
US100_CRON_DRY_RUN=false

# Required when US100_STORAGE_PROVIDER=supabase.
# In auto mode, the app falls back to fixture data when these are missing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional read-only key for public published reads.
SUPABASE_ANON_KEY=

# Required on Vercel for /api/cron/morning-brew.
CRON_SECRET=

# Required when US100_GENERATION_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
