US100_STORAGE_PROVIDER=auto
US100_RESEARCH_PROVIDER=fixture
US100_GENERATION_PROVIDER=fixture
US100_GENERATION_TARGET_STATUS=draft
US100_CRON_LOCALES=pl,en
US100_CRON_DRY_RUN=false
US100_BUDGET_MAX_REQUESTS=30
US100_BUDGET_REQUEST_TIMEOUT_MS=8000
US100_BUDGET_NEWS_RSS_ENABLED=true
US100_BUDGET_NEWS_LIMIT=6
US100_BUDGET_NEWS_RSS_URL=
US100_RERUN_MAX_REQUESTS=15
US100_RERUN_REQUEST_TIMEOUT_MS=4000
US100_RERUN_OPENAI_TIMEOUT_MS=45000
US100_RERUN_OPENAI_MAX_OUTPUT_TOKENS=6000
US100_RERUN_OPENAI_REASONING_EFFORT=minimal
US100_RERUN_OPENAI_TEXT_VERBOSITY=low
US100_RERUN_NEWS_RSS_ENABLED=false
US100_FULL_RERUN_MAX_REQUESTS=30
US100_FULL_RERUN_REQUEST_TIMEOUT_MS=8000
US100_FULL_RERUN_OPENAI_TIMEOUT_MS=50000
US100_FULL_RERUN_OPENAI_MAX_OUTPUT_TOKENS=6500
US100_FULL_RERUN_OPENAI_REASONING_EFFORT=minimal
US100_FULL_RERUN_OPENAI_TEXT_VERBOSITY=low
US100_FULL_RERUN_NEWS_RSS_ENABLED=true
US100_FULL_RERUN_MIN_SOURCES=8
US100_WEEKLY_SUMMARY_ENABLED=true
US100_WEEKLY_SUMMARY_MIN_SOURCES=8

# Required when US100_STORAGE_PROVIDER=supabase.
# In auto mode, the app falls back to fixture data when these are missing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional read-only key for public published reads.
SUPABASE_ANON_KEY=

# Required on Vercel for /api/cron/morning-brew.
CRON_SECRET=

# Required on Vercel for private /review approval pages.
US100_REVIEW_SECRET=
US100_REVIEW_EMAILS=

# Required when US100_GENERATION_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=6500
OPENAI_REASONING_EFFORT=minimal
OPENAI_REQUEST_TIMEOUT_MS=45000
OPENAI_TEXT_VERBOSITY=low

# Optional free macro data provider for budget research.
FRED_API_KEY=

# Optional. When enabled, approval creates a Kit broadcast draft.
US100_NEWSLETTER_PROVIDER=disabled
KIT_API_KEY=
KIT_EMAIL_TEMPLATE_ID=
KIT_BROADCAST_PUBLIC=false
KIT_SUBSCRIBER_FILTER=
NEXT_PUBLIC_APP_URL=
